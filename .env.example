# ───────────────────────────────────────────
# Multi-Agent RAG Tutor — Environment Variables
# ───────────────────────────────────────────

# LLM Provider (choose one):
#   "groq"   → fast inference, free tier available (DEFAULT)
#   "openai" → OpenAI API
#   "gguf"   → local GGUF model file
#   "ollama" → local Ollama server
LLM_PROVIDER=groq

# ── Groq (RECOMMENDED — fast, free tier) ──
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ── OpenAI (optional) ──
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Local GGUF (optional, requires llama-cpp-python) ──
# LLM_MODEL=gemma-4-E2B-it-Q4_K_M.gguf
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=2048

# ── Ollama (optional, local) ──
# OLLAMA_BASE_URL=http://localhost:11434

# ── CORS (default allows localhost dev) ──
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
